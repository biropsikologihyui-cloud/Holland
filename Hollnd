            { cat: 'S', text: "Saya sering menjadi tempat curhat bagi teman-teman saya." },
            { cat: 'S', text: "Saya suka berkolaborasi daripada berkompetisi secara tajam." },
            { cat: 'S', text: "Saya ingin memberikan dampak positif bagi kehidupan masyarakat." },
            { cat: 'S', text: "Saya cocok berkarir di bidang pendidikan, layanan sosial, atau HRD." },

            // Enterprising (E) - 18 items
            { cat: 'E', text: "Saya suka memimpin proyek atau mengarahkan sebuah tim." },
            { cat: 'E', text: "Saya percaya diri saat berbicara di depan umum atau berpresentasi." },
            { cat: 'E', text: "Saya senang meyakinkan atau membujuk orang lain untuk menerima ide saya." },
            { cat: 'E', text: "Saya tertarik untuk memulai atau mengelola bisnis sendiri." },
            { cat: 'E', text: "Saya berani mengambil risiko untuk meraih keuntungan atau keberhasilan." },
            { cat: 'E', text: "Saya berambisi untuk mencapai posisi kepemimpinan atau target tinggi." },
            { cat: 'E', text: "Saya menikmati negosiasi jual-beli atau kesepakatan bisnis." },
            { cat: 'E', text: "Saya kompetitif dan bersemangat mencapai target pencapaian." },
            { cat: 'E', text: "Saya pandai membangun jaringan (networking) dengan orang penting." },
            { cat: 'E', text: "Saya suka merencanakan strategi pemasaran atau kampanye promosi." },
            { cat: 'E', text: "Saya tidak ragu dalam mengambil keputusan penting dengan cepat." },
            { cat: 'E', text: "Saya tertarik pada bidang politik, hukum, atau manajemen bisnis." },
            { cat: 'E', text: "Saya menikmati persaingan dalam dunia usaha." },
            { cat: 'E', text: "Saya pandai memanfaatkan peluang yang menguntungkan." },
            { cat: 'E', text: "Saya suka mengorganisir acara besar atau kegiatan penggalangan dana." },
            { cat: 'E', text: "Saya termotivasi oleh insentif finansial dan pengakuan atas keberhasilan." },
            { cat: 'E', text: "Saya mahir menjual produk, jasa, atau gagasan." },
            { cat: 'E', text: "Saya bercita-cita menjadi eksekutif, manajer, atau wirausahawan." },

            // Conventional (C) - 18 items
            { cat: 'C', text: "Saya suka bekerja dengan data, angka, dan dokumen secara teratur." },
            { cat: 'C', text: "Saya menyukai pekerjaan yang memiliki aturan dan prosedur jelas." },
            { cat: 'C', text: "Saya teliti dan cermat dalam memeriksa detail-detail kecil." },
            { cat: 'C', text: "Saya senang menyusun arsip, jadwal, atau laporan keuangan." },
            { cat: 'C', text: "Saya menyukai rutinitas kerja yang stabil dan dapat diprediksi." },
            { cat: 'C', text: "Saya menghargai ketepatan waktu dan kerapian dalam bekerja." },
            { cat: 'C', text: "Saya tertarik pada bidang akuntansi, administrasi, atau perbankan." },
            { cat: 'C', text: "Saya nyaman mengoperasikan spreadsheet (seperti Excel) untuk olah data." },
            { cat: 'C', text: "Saya menyukai instruksi langsung dari atasan daripada berasumsi sendiri." },
            { cat: 'C', text: "Saya pandai mengorganisasi arsip fisik maupun digital secara terstruktur." },
            { cat: 'C', text: "Saya selalu mengoreksi kembali pekerjaan saya agar terhindar dari kesalahan." },
            { cat: 'C', text: "Saya lebih menyukai lingkungan kerja kantor yang teratur." },
            { cat: 'C', text: "Saya disiplin dalam mengikuti standar operasional prosedur (SOP)." },
            { cat: 'C', text: "Saya merasa puas jika semua berkas dan laporan tersusun rapi." },
            { cat: 'C', text: "Saya mahir dalam tugas-tugas pengetikan, input data, dan audit." },
            { cat: 'C', text: "Saya jarang menunda pekerjaan yang sudah terjadwal." },
            { cat: 'C', text: "Saya lebih memilih kepastian daripada ketidakpastian dalam tugas." },
            { cat: 'C', text: "Saya cocok bekerja sebagai akuntan, sekretaris, atau administrator data." }
        ];

        const totalQuestions = questions.length; // 108
        const questionsPerPage = 10;
        let currentPage = 1;
        const totalPages = Math.ceil(totalQuestions / questionsPerPage);

        // Store user answers: { [index]: 1 (Ya) | 0 (Tidak) }
        let userAnswers = {};
        let riasecChartObj = null;

        async function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('loginUsername').value.trim();
            const p = document.getElementById('loginPassword').value.trim();
            const btn = document.getElementById('btnLoginSubmit');
            const errEl = document.getElementById('loginError');

            errEl.classList.add('hidden');
            btn.disabled = true;
            btn.innerText = "Memverifikasi...";

            try {
                // Autentikasi langsung ke Google Apps Script tanpa hardcoded password
                const response = await fetch(APPS_SCRIPT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        action: 'login',
                        username: u,
                        password: p
                    })
                });

                const res = await response.json();

                if (res.status === 'success') {
                    currentActiveUser = res.user || { username: u, nama: u };
                    document.getElementById('loginScreen').classList.add('hidden');
                    document.getElementById('testScreen').classList.remove('hidden');
                    document.getElementById('userInfo').classList.remove('hidden');
                    document.getElementById('displayUsername').innerText = currentActiveUser.nama || currentActiveUser.username;
                    renderPage();
                } else {
                    errEl.innerText = res.message || "Username atau Password salah!";
                    errEl.classList.remove('hidden');
                }
            } catch (error) {
                console.error("Login API Error:", error);
                errEl.innerText = "Gagal terhubung ke Server Biro. Periksa koneksi internet Anda.";
                errEl.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerText = "Masuk Sekarang";
            }
        }

        function logout() {
            currentActiveUser = null;
            document.getElementById('userInfo').classList.add('hidden');
            document.getElementById('testScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('loginScreen').classList.remove('hidden');
            document.getElementById('loginForm').reset();
        }

        function renderPage() {
            const container = document.getElementById('questionsContainer');
            container.innerHTML = '';

            const startIndex = (currentPage - 1) * questionsPerPage;
            const endIndex = Math.min(startIndex + questionsPerPage, totalQuestions);

            for (let i = startIndex; i < endIndex; i++) {
                const q = questions[i];
                const qNum = i + 1;
                const isCheckedYes = userAnswers[i] === 1 ? 'checked' : '';
                const isCheckedNo = userAnswers[i] === 0 ? 'checked' : '';

                const card = document.createElement('div');
                card.className = "bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-indigo-200 transition-all";
                card.innerHTML = `
                    <div class="flex items-start gap-3 flex-1">
                        <span class="bg-indigo-50 text-indigo-700 font-bold px-2.5 py-1 rounded-lg text-xs shrink-0 border border-indigo-100">${qNum}</span>
                        <p class="text-slate-700 text-xs sm:text-sm font-medium leading-relaxed">${q.text}</p>
                    </div>
                    <div class="flex items-center gap-4 self-end sm:self-center border-t sm:border-t-0 pt-2 sm:pt-0 w-full sm:w-auto justify-end shrink-0">
                        <label class="inline-flex items-center cursor-pointer gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-emerald-50 hover:border-emerald-200 transition">
                            <input type="radio" name="q_${i}" value="1" ${isCheckedYes} onchange="saveAnswer(${i}, 1)" class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                            <span class="text-xs font-bold text-slate-700">Ya</span>
                        </label>
                        <label class="inline-flex items-center cursor-pointer gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-rose-50 hover:border-rose-200 transition">
                            <input type="radio" name="q_${i}" value="0" ${isCheckedNo} onchange="saveAnswer(${i}, 0)" class="w-4 h-4 text-rose-600 focus:ring-rose-500">
                            <span class="text-xs font-bold text-slate-700">Tidak</span>
                        </label>
                    </div>
                `;
                container.appendChild(card);
            }

            // Update Page Controls & Text
            document.getElementById('pageIndicator').innerText = `Halaman ${currentPage} dari ${totalPages}`;
            document.getElementById('prevBtn').disabled = currentPage === 1;

            if (currentPage === totalPages) {
                document.getElementById('nextBtn').classList.add('hidden');
                document.getElementById('submitBtn').classList.remove('hidden');
            } else {
                document.getElementById('nextBtn').classList.remove('hidden');
                document.getElementById('submitBtn').classList.add('hidden');
            }

            updateProgress();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function saveAnswer(index, val) {
            userAnswers[index] = val;
            updateProgress();
        }

        function updateProgress() {
            const answeredCount = Object.keys(userAnswers).length;
            const pct = Math.round((answeredCount / totalQuestions) * 100);
            document.getElementById('progressBar').style.width = pct + '%';
            document.getElementById('progressPercent').innerText = `${pct}% Terjawab (${answeredCount}/${totalQuestions})`;
        }

        function changePage(delta) {
            currentPage += delta;
            renderPage();
        }

        async function calculateResult() {
            const answeredCount = Object.keys(userAnswers).length;
            if (answeredCount < totalQuestions) {
                const proceed = confirm(`Anda baru menjawab ${answeredCount} dari ${totalQuestions} pertanyaan. Apakah Anda yakin ingin melihat hasil sekarang?`);
                if (!proceed) return;
            }

            const answersArray = [];
            const scores = { R: 0, I: 0, A: 0, S: 0, E: 0, C: 0 };

            questions.forEach((q, idx) => {
                const val = userAnswers[idx] === 1 ? 1 : 0;
                answersArray.push(val);
                if (val === 1) scores[q.cat]++;
            });

            // Kirim Hasil Pengujian ke Backend Google Apps Script (Auto-save ke Sheet & Biro Email)
            try {
                fetch(APPS_SCRIPT_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        action: 'submit_test',
                        username: currentActiveUser ? currentActiveUser.username : 'Guest',
                        nama: currentActiveUser ? currentActiveUser.nama : 'Guest',
                        answers: answersArray
                    })
                });
            } catch (err) {
                console.error("Gagal mengirimkan data ke Biro:", err);
            }

            document.getElementById('testScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');

            renderChartAndAnalysis(scores);
        }

        function renderChartAndAnalysis(scores) {
            const catNames = {
                R: 'Realistic',
                I: 'Investigative',
                A: 'Artistic',
                S: 'Social',
                E: 'Enterprising',
                C: 'Conventional'
            };

            const sortedCats = Object.keys(scores).sort((a, b) => scores[b] - scores[a]);
            const top3Code = sortedCats.slice(0, 3).join('');

            document.getElementById('topCode').innerText = top3Code;

            // Breakdown list
            const breakdownEl = document.getElementById('categoryBreakdown');
            breakdownEl.innerHTML = '';
            sortedCats.forEach(cat => {
                const score = scores[cat];
                const pct = Math.round((score / 18) * 100);
                breakdownEl.innerHTML += `
                    <div class="flex items-center justify-between text-xs py-1.5 border-b border-slate-200/60">
                        <span class="font-semibold text-slate-700">${catNames[cat]} (${cat})</span>
                        <div class="flex items-center gap-2">
                            <span class="font-mono font-bold text-indigo-600">${score}/18</span>
                            <span class="text-slate-400">(${pct}%)</span>
                        </div>
                    </div>
                `;
            });

            // Career Recommendations Text Map
            const details = {
                R: "<b>Realistic (Praktis & Fisik)</b>: Menyukai pekerjaan praktis, penggunaan mesin, alat-alat perkakas, dan outdoor.<br><span class='text-slate-500'>Prospek Karir:</span> Tekniker, Mekanik, Pilot, Arsitek Landskap, Otomotif, Teknik Sipil.",
                I: "<b>Investigative (Analitis & Penelitian)</b>: Menyukai investigasi, analisis data, eksperimen, dan riset ilmiah.<br><span class='text-slate-500'>Prospek Karir:</span> Peneliti, Data Scientist, Dokter, Software Engineer, Ahli Biologi, Akademisi.",
                A: "<b>Artistic (Kreatif & Ekspresif)</b>: Menyukai kreasi seni, ekspresi bebas, desain visual, musik, dan tulisan.<br><span class='text-slate-500'>Prospek Karir:</span> Desainer Grafis, Writer, Musisi, Arsitek, Animator, Fotografer.",
                S: "<b>Social (Pelayanan & Edukasi)</b>: Menyukai kegiatan membantu, mengajar, membimbing, dan merawat orang lain.<br><span class='text-slate-500'>Prospek Karir:</span> Guru/Pengajar, Psikolog, Konselor, Perawat, Konsultan HRD.",
                E: "<b>Enterprising (Persuasif & Bisnis)</b>: Menyukai kepemimpinan, pemasaran, negosiasi, dan kewirausahaan.<br><span class='text-slate-500'>Prospek Karir:</span> Wirausahawan, Manajer, Marketing Executive, Pengacara, Politisi.",
                C: "<b>Conventional (Administratif & Detail)</b>: Menyukai data terstruktur, pencatatan, ketelitian, dan sistem kantor.<br><span class='text-slate-500'>Prospek Karir:</span> Akuntan, Auditor, Administrator Bank, Data Entry, Notaris."
            };

            const recTextEl = document.getElementById('recommendationText');
            recTextEl.innerHTML = sortedCats.slice(0, 3).map(c => `
                <div class="p-4 bg-white rounded-xl border border-indigo-100 shadow-sm border-l-4 border-l-indigo-600">
                    ${details[c]}
                </div>
            `).join('');

            // Build Radar Chart
            const ctx = document.getElementById('riasecChart').getContext('2d');
            if (riasecChartObj) riasecChartObj.destroy();

            riasecChartObj = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Realistic', 'Investigative', 'Artistic', 'Social', 'Enterprising', 'Conventional'],
                    datasets: [{
                        label: 'Skor RIASEC',
                        data: [scores.R, scores.I, scores.A, scores.S, scores.E, scores.C],
                        backgroundColor: 'rgba(79, 70, 229, 0.25)',
                        borderColor: 'rgba(79, 70, 229, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: 'rgba(79, 70, 229, 1)',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        r: {
                            angleLines: { color: '#e2e8f0' },
                            grid: { color: '#f1f5f9' },
                            pointLabels: {
                                font: { size: 10, weight: '600', family: 'Inter' },
                                color: '#475569'
                            },
                            suggestedMin: 0,
                            suggestedMax: 18,
                            ticks: { stepSize: 3, display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        function restartTest() {
            userAnswers = {};
            currentPage = 1;
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('testScreen').classList.remove('hidden');
            renderPage();
        }
    </script>
</body>
</html>
