            { cat: 'A', text: "Saya senang mencoba kombinasi warna, busana, atau estetika baru." },
            { cat: 'A', text: "Saya lebih suka spontanitas daripada rutinitas yang terencana." },
            { cat: 'A', text: "Saya peka terhadap keindahan alam, karya seni, atau desain visual." },
            { cat: 'A', text: "Saya tertarik dalam dunia akting, fotografi, atau pembuatan film." },
            { cat: 'A', text: "Saya suka menciptakan karya visual orisinal dengan tangan atau perangkat lunak." },
            { cat: 'A', text: "Saya merasa terkekang jika harus mengikuti prosedur rutin berulang-ulang." },
            { cat: 'A', text: "Saya mengekspresikan perasaan saya lewat media artistik." },
            { cat: 'A', text: "Saya suka menggubah lagu, koreografi, atau naskah." },
            { cat: 'A', text: "Saya menikmati lingkungan kerja yang fleksibel dan santai." },
            { cat: 'A', text: "Saya selalu mencari sudut pandang unik dalam memandang sesuatu." },
            { cat: 'A', text: "Saya berminat pada karir di bidang desain, media, atau seni kreatif." },

            // Social (S) - 18 items
            { cat: 'S', text: "Saya suka membantu orang lain menyelesaikan masalah pribadi mereka." },
            { cat: 'S', text: "Saya menikmati mengajar, melatih, atau membimbing orang lain." },
